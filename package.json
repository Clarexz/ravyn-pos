{
  "name": "pos-papelerias",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @pos/db db:migrate",
    "db:generate": "pnpm --filter @pos/db db:generate",
    "dev": "pnpm --filter @pos/core --filter @pos/db build && concurrently -n server,pos -c blue,green \"pnpm --filter @pos/server dev\" \"pnpm --filter @pos/pos dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
